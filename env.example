# Copy this file to .env and fill in your values

# From @BotFather
BOT_TOKEN=123456:your-token-from-botfather

# MongoDB connection string (e.g. a free MongoDB Atlas cluster)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=photobot

# Your private photo group's ID (add the bot, then send /id in the group).
# Looks like -1001234567890
GROUP_ID=

# Password you type after /addphotos in a private chat with the bot, to add photos
# from anywhere. Needed every time; the bot never remembers your account.
# Pick something long. Leave empty to turn /addphotos off.
ADMIN_PASSWORD=

# Used for the default photo date when a caption has no date
TIMEZONE=America/New_York

# true = clients can't forward/save files from the chat (screenshots still possible)
PROTECT_CONTENT=false

# Most files sent per button press
MAX_SEND=200
