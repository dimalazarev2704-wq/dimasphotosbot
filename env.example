# Copy this file to .env and fill in your values

# From @BotFather
BOT_TOKEN=123456:your-token-from-botfather

# MongoDB connection string (e.g. a free MongoDB Atlas cluster)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=photobot

# Your private photo group's ID (add the bot, then send /id in the group).
# Looks like -1001234567890
GROUP_ID=

# YOUR Telegram user ID (send /id to the bot in a private chat; the number it replies
# with is your ID). That account gets the /admin panel and skips the /addphotos
# password. The bot stores nothing about you.
OWNER_ID=

# Password for /addphotos in a private chat, for anyone who is NOT the owner.
# Needed every time; the bot never remembers the account. Pick something long.
# Leave empty to turn it off for everyone except the owner.
ADMIN_PASSWORD=

# Used for the default photo date when a caption has no date
TIMEZONE=America/New_York

# true = clients can't forward/save files from the chat (screenshots still possible)
PROTECT_CONTENT=false

# Most files sent per button press
MAX_SEND=200
